{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@rivocode/common/*": [
        "./common/src/*"
      ],
      "@rivocode/sdk": [
        "./sdk/src/index.ts"
      ],
      "@rivocode/sdk/*": [
        "./sdk/*"
      ],
      "@rivocode/agent-runtime/*": [
        "./packages/agent-runtime/src/*"
      ],
      "@rivocode/llm-providers/*": [
        "./packages/llm-providers/src/*"
      ],
      "@rivocode/code-map/*": [
        "./packages/code-map/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./common"
    },
    {
      "path": "./agents"
    },
    {
      "path": "./sdk"
    },
    {
      "path": "./cli"
    },
    {
      "path": "./packages/agent-runtime"
    },
    {
      "path": "./packages/code-map"
    },
    {
      "path": "./packages/llm-providers"
    }
  ]
}
